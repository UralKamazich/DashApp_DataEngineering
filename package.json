{
  "name": "dataanalize-desktop",
  "version": "1.0.27",
  "description": "DataAnalize Desktop Application - Dash Data Engineering Tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:dir": "electron-builder --mac dir"
  },
  "author": "Ural Muslimov",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.dataanalize.desktop",
    "productName": "DataAnalize",
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filters": [
          "*.py",
          "callbacks/**/*",
          "assets/**/*",
          "cert.pem",
          "key.pem",
          "config.py",
          "components.py",
          "dash_app.py",
          "layout.py",
          "utils.py",
          ".venv/**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
