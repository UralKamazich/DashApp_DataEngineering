{
  "name": "dataanalize-desktop",
  "version": "2.0.0",
  "description": "DataAnalize Desktop Application - Dash Data Engineering Tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:dir": "electron-builder --mac dir",
    "build:win": "electron-builder --win --publish never",
    "build:win:dir": "electron-builder --win dir"
  },
  "author": "Ural Muslimov",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.dataanalize.desktop",
    "productName": "DataAnalize",
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": ".venv",
          "to": "app/.venv",
          "filter": ["**/*"]
        }
      ]
    },
    "win": {
      "icon": "favicon.ico",
      "target": [
        {"target": "nsis", "arch": ["x64"]},
        {"target": "zip", "arch": ["x64"]}
      ],
      "extraResources": [
        {
          "from": "python-dist/dataanalize-server",
          "to": "server",
          "filter": ["**/*"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DataAnalize"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "*.py",
          "callbacks/**/*",
          "assets/**/*",
          "cert.pem",
          "key.pem",
          "config.py",
          "components.py",
          "dash_app.py",
          "layout.py",
          "utils.py",
          "!tests/**/*"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  }
}
